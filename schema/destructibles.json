{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vsdemake:destructibles",
  "title": "Destructible light sources",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[A-Z0-9_]+$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "textureName": {
        "type": "string"
      },
      "frameName": {
        "type": "string"
      },
      "destroyedAmount": {
        "type": "integer"
      },
      "maxHp": {
        "type": "number"
      },
      "destructibleType": {
        "type": "string"
      }
    },
    "required": [
      "textureName",
      "frameName",
      "maxHp"
    ],
    "additionalProperties": false
  }
}
