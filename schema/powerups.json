{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vsdemake:powerups",
  "title": "Shop power-ups, one array of per-rank deltas per power-up",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[A-Z0-9_]+$"
  },
  "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "prefixItems": [
      {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer"
          },
          "bulletType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "texture": {
            "type": "string"
          },
          "frameName": {
            "type": "string"
          },
          "isPowerUp": {
            "type": "boolean"
          },
          "price": {
            "type": "integer"
          },
          "hidden": {
            "type": "boolean"
          },
          "power": {
            "type": "number"
          },
          "cooldown": {
            "type": "number"
          },
          "area": {
            "type": "number"
          },
          "speed": {
            "type": "number"
          },
          "duration": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          },
          "luck": {
            "type": "number"
          },
          "growth": {
            "type": "number"
          },
          "greed": {
            "type": "number"
          },
          "magnet": {
            "type": "number"
          },
          "moveSpeed": {
            "type": "number"
          },
          "armor": {
            "type": "number"
          },
          "regen": {
            "type": "number"
          },
          "maxHp": {
            "type": "number"
          }
        },
        "required": [
          "level",
          "bulletType",
          "name",
          "price"
        ],
        "additionalProperties": false
      }
    ],
    "items": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer"
        },
        "bulletType": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "texture": {
          "type": "string"
        },
        "frameName": {
          "type": "string"
        },
        "isPowerUp": {
          "type": "boolean"
        },
        "price": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean"
        },
        "power": {
          "type": "number"
        },
        "cooldown": {
          "type": "number"
        },
        "area": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "amount": {
          "type": "number"
        },
        "luck": {
          "type": "number"
        },
        "growth": {
          "type": "number"
        },
        "greed": {
          "type": "number"
        },
        "magnet": {
          "type": "number"
        },
        "moveSpeed": {
          "type": "number"
        },
        "armor": {
          "type": "number"
        },
        "regen": {
          "type": "number"
        },
        "maxHp": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    }
