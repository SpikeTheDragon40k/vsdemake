        },
        "area": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "duration": {
          "type": "number"
        },
        "amount": {
          "type": "number"
        },
        "luck": {
          "type": "number"
        },
        "growth": {
          "type": "number"
        },
        "greed": {
          "type": "number"
        },
        "magnet": {
          "type": "number"
        },
        "moveSpeed": {
          "type": "number"
        },
        "armor": {
          "type": "number"
        },
        "regen": {
          "type": "number"
        },
        "maxHp": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
